{
  "name": "ty-code",
  "version": "1.0.0",
  "description": "Standalone Electron Desktop AI Coding Assistant with Monaco Editor and Pluggable LLMs",
  "main": "dist/main/index.js",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:force": "node scripts/dev.mjs --force",
    "dev:electron": "node scripts/dev.mjs",
    "dev:electron:force": "node scripts/dev.mjs --force",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:node-pty --external:simple-git --external:electron-updater --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test": "node scripts/no-mock-agent-path.mjs && node scripts/no-fixture-replies.mjs && node scripts/no-baked-secrets.mjs && node scripts/no-metadata-only-marketplace.mjs && node scripts/no-fake-extension-data.mjs && node scripts/verify-extension-artifacts.mjs && node scripts/verify-audit-artifacts.mjs && npm run test:live && npm run test:extensions && npm run test:security && npm run typecheck && npm run typecheck:website && npm run audit:security && npm run deps:check",
    "test:live": "node scripts/run-live-e2e.mjs",
    "test:extensions": "node scripts/run-extension-marketplace-tests.mjs",
    "test:security": "node scripts/run-extension-security.mjs",
    "trace:extensions": "node scripts/run-extension-trace.mjs",
    "test:no-baked-secrets": "node scripts/no-baked-secrets.mjs",
    "guards": "node scripts/no-mock-agent-path.mjs && node scripts/no-fixture-replies.mjs && node scripts/no-baked-secrets.mjs && node scripts/no-metadata-only-marketplace.mjs && node scripts/no-fake-extension-data.mjs && node scripts/verify-extension-artifacts.mjs && node scripts/verify-audit-artifacts.mjs",
    "guard:artifacts": "node scripts/verify-audit-artifacts.mjs",
    "guard:extension-artifacts": "node scripts/verify-extension-artifacts.mjs",
    "guard:fixtures": "node scripts/no-fixture-replies.mjs",
    "guard:mocks": "node scripts/no-mock-agent-path.mjs",
    "guard:marketplace": "node scripts/no-metadata-only-marketplace.mjs",
    "guard:fake-extensions": "node scripts/no-fake-extension-data.mjs",
    "guard:secrets": "node scripts/no-baked-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "deps:check": "npx --yes depcheck@1.4.7",
    "preview": "electron dist/main/index.js",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:all": "npm run build && electron-builder -mwl --publish never",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "dev:website": "vite --config website/vite.config.ts",
    "build:website": "vite build --config website/vite.config.ts",
    "build:pages": "npm run build:website",
    "pages:deploy": "npx --yes wrangler pages deploy ./website-dist",
    "typecheck:website": "tsc --noEmit --project website/tsconfig.json"
  },
  "keywords": [
    "electron",
    "monaco-editor",
    "ai-assistant",
    "claude-code",
    "coding-agent",
    "openrouter",
    "ollama"
  ],
  "author": "Ty-Code Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.9",
    "highlight.js": "11.12.0",
    "lucide-react": "1.56.0",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "simple-git": "4.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.2",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
