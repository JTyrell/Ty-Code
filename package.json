{
  "name": "ty-code",
  "version": "1.0.0",
  "description": "Standalone Electron Desktop AI Coding Assistant with Monaco Editor and Pluggable LLMs",
  "main": "dist/main/index.js",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:force": "node scripts/dev.mjs --force",
    "dev:electron": "node scripts/dev.mjs",
    "dev:electron:force": "node scripts/dev.mjs --force",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:node-pty --external:simple-git --external:electron-updater --external:typescript --external:playwright-core --outfile=dist/main/index.js && node scripts/build-debugger-workers.mjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "prepare:voice-engine": "node resources/voice-engine/build-voice-engine.mjs",
    "test": "node scripts/no-mock-agent-path.mjs && node scripts/no-fixture-replies.mjs && node scripts/chaos-hook-guard.mjs && node scripts/no-baked-secrets.mjs && node scripts/no-metadata-only-marketplace.mjs && node scripts/no-fake-extension-data.mjs && node scripts/verify-attribution.mjs && node scripts/verify-fcc-coverage.mjs && node scripts/no-policy-bypass.mjs && npm run test:unit && npm run test:unit:main && npm run test:live && npm run test:extensions && npm run test:security && node scripts/verify-extension-artifacts.mjs && node scripts/verify-audit-artifacts.mjs && npm run typecheck && npm run typecheck:website && npm run audit:security && npm run deps:check",
    "test:unit": "vitest run --root src/renderer",
    "test:unit:main": "vitest run --config vitest.main.config.ts",
    "test:live": "node scripts/run-live-e2e.mjs",
    "test:extensions": "node scripts/run-extension-marketplace-tests.mjs",
    "test:security": "node scripts/run-extension-security.mjs",
    "test:fcc-coverage": "node scripts/verify-fcc-coverage.mjs",
    "trace:extensions": "node scripts/run-extension-trace.mjs",
    "test:no-baked-secrets": "node scripts/no-baked-secrets.mjs",
    "guards": "node scripts/no-mock-agent-path.mjs && node scripts/no-fixture-replies.mjs && node scripts/chaos-hook-guard.mjs && node scripts/no-baked-secrets.mjs && node scripts/no-metadata-only-marketplace.mjs && node scripts/no-fake-extension-data.mjs && node scripts/verify-extension-artifacts.mjs && node scripts/verify-audit-artifacts.mjs && node scripts/verify-attribution.mjs && node scripts/verify-fcc-coverage.mjs && node scripts/no-network-scanner.mjs && node scripts/no-policy-bypass.mjs",
    "guard:chaos-hook": "node scripts/chaos-hook-guard.mjs",
    "guard:attribution": "node scripts/verify-attribution.mjs",
    "guard:fcc-coverage": "node scripts/verify-fcc-coverage.mjs",
    "guard:artifacts": "node scripts/verify-audit-artifacts.mjs",
    "guard:extension-artifacts": "node scripts/verify-extension-artifacts.mjs",
    "guard:fixtures": "node scripts/no-fixture-replies.mjs",
    "guard:mocks": "node scripts/no-mock-agent-path.mjs",
    "guard:marketplace": "node scripts/no-metadata-only-marketplace.mjs",
    "guard:fake-extensions": "node scripts/no-fake-extension-data.mjs",
    "guard:secrets": "node scripts/no-baked-secrets.mjs",
    "guard:network-scanner": "node scripts/no-network-scanner.mjs",
    "guard:policy": "node scripts/no-policy-bypass.mjs",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "deps:check": "npx --yes depcheck@1.4.7",
    "preview": "electron dist/main/index.js",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:all": "npm run build && electron-builder -mwl --publish never",
    "package:staged": "python scripts/build-cross-packages.py",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "dev:website": "vite --config website/vite.config.ts",
    "build:website": "vite build --config website/vite.config.ts",
    "build:pages": "npm run build:website",
    "pages:deploy": "npx --yes wrangler pages deploy ./website-dist",
    "typecheck:website": "tsc --noEmit --project website/tsconfig.json",
    "build:campaign": "node scripts/campaign/build-campaign.mjs",
    "build:campaign:html": "node scripts/campaign/build-html.mjs",
    "build:campaign:pdf": "node scripts/campaign/build-pdf.mjs",
    "build:campaign:docx": "node scripts/campaign/build-docx.mjs",
    "build:campaign:manifest": "node scripts/campaign/build-manifest.mjs",
    "build:deck": "marp docs/INVESTOR-PITCH-DECK.md --pptx --pdf --html -o dist/campaign/"
  },
  "keywords": [
    "electron",
    "monaco-editor",
    "ai-assistant",
    "claude-code",
    "coding-agent",
    "openrouter",
    "ollama"
  ],
  "author": "Ty-Code Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "3.14.22",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cross-spawn": "7.0.6",
    "dompurify": "3.4.17",
    "electron-updater": "6.8.9",
    "highlight.js": "11.12.0",
    "html-to-image": "1.11.13",
    "katex": "0.19.1",
    "lucide-react": "1.56.0",
    "marked": "18.1.1",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "node-vibrant": "4.0.4",
    "playwright-core": "1.64.1",
    "react-color": "2.19.3",
    "react-markdown": "10.1.0",
    "simple-git": "4.0.2",
    "tiktoken": "1.0.22",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "@types/dompurify": "3.0.5",
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-color": "3.0.13",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.10.2",
    "electron": "42.11.18",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "html-to-docx": "1.8.0",
    "jsdom": "24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.4"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "@xmldom/xmldom": "^0.9.12",
    "basic-ftp": "^6.2.3",
    "puppeteer-core": "^25.16.0"
  }
}
