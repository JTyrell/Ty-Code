{
  "name": "ty-code",
  "version": "0.1.0",
  "description": "Standalone Electron Desktop AI Coding Assistant with Monaco Editor and Pluggable LLMs",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:node-pty --external:simple-git --external:electron-updater --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test:agent": "node scripts/validate-phase2.mjs",
    "test:git": "node scripts/validate-phase3.mjs",
    "test:extensions": "node scripts/validate-phase4.mjs",
    "test:lsp": "node scripts/validate-phase5.mjs",
    "test:polish": "node scripts/validate-phase6.mjs",
    "test:bonus": "node scripts/validate-phase7.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:agent && npm run test:git && npm run test:extensions && npm run test:lsp && npm run test:polish && npm run test:bonus",
    "preview": "electron dist/main/index.js",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "release:notes": "node scripts/generate-release-notes.mjs"
  },
  "keywords": [
    "electron",
    "monaco-editor",
    "ai-assistant",
    "claude-code",
    "antigravity",
    "coding-agent",
    "openrouter",
    "ollama"
  ],
  "author": "Ty-Code Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "simple-git": "^4.0.2",
    "vscode-languageserver-protocol": "^3.18.4",
    "vscode-languageserver-types": "^3.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
