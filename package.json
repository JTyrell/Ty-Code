{
  "name": "ty-code",
  "version": "0.1.0",
  "description": "Standalone Electron Desktop AI Coding Assistant with Monaco Editor and Pluggable LLMs",
  "main": "dist/main/index.js",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:node-pty --external:simple-git --external:electron-updater --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "test:agent": "node scripts/validate-phase2.mjs",
    "test:security-settings": "node scripts/validate-phase2-2.mjs",
    "test:settings-ui": "node scripts/validate-phase2-3.mjs",
    "test:security-wiring": "node scripts/validate-phase2-4.mjs",
    "test:git": "node scripts/validate-phase3.mjs",
    "test:extensions": "node scripts/validate-phase4.mjs",
    "test:lsp": "node scripts/validate-phase5.mjs",
    "test:polish": "node scripts/validate-phase6.mjs",
    "test:bonus": "node scripts/validate-phase7.mjs",
    "test:omniroute": "node scripts/validate-phase5-1.mjs",
    "test:fcc": "node scripts/validate-phase5-2.mjs",
    "test:onboarding": "node scripts/validate-phase2-1.mjs",
    "test:opencode": "node scripts/validate-phase5-3.mjs",
    "test:openkilo": "node scripts/validate-phase5-4.mjs",
    "test:orchestration": "node scripts/validate-phase5-5.mjs",
    "test:e2e-perf": "node scripts/validate-phase5-6.mjs",
    "test:integrations": "node scripts/validate-phase3-1.mjs",
    "test:ecc": "node scripts/validate-phase3-2.mjs",
    "test:history-export": "node scripts/validate-phase3-3.mjs",
    "test:bento": "node scripts/validate-phase3-4.mjs",
    "test:sketcher": "node scripts/validate-phase3-5.mjs",
    "test:seo-mcp": "node scripts/validate-phase3-6.mjs",
    "test:free-registry": "node scripts/validate-phase6-1.mjs",
    "test:byok": "node scripts/validate-phase6-2.mjs",
    "test:opencode-sync": "node scripts/validate-phase6-3.mjs",
    "test:model-router": "node scripts/validate-phase6-4.mjs",
    "test:provider-dashboard": "node scripts/validate-phase6-5.mjs",
    "test:free-validation": "node scripts/validate-phase6-6.mjs",
    "test:privacy": "node scripts/validate-phase3-privacy.mjs",
    "test:security-build": "node scripts/validate-security-build.mjs",
    "audit:security": "npm audit --audit-level=high",
    "deps:check": "npx --yes depcheck@1.4.7",
    "typecheck": "tsc --noEmit",
    "test:phases": "npm run test:onboarding && npm run test:agent && npm run test:security-settings && npm run test:settings-ui && npm run test:security-wiring && npm run test:git && npm run test:extensions && npm run test:lsp && npm run test:polish && npm run test:bonus && npm run test:omniroute && npm run test:fcc && npm run test:opencode && npm run test:openkilo && npm run test:orchestration && npm run test:e2e-perf && npm run test:integrations && npm run test:ecc && npm run test:history-export && npm run test:bento && npm run test:sketcher && npm run test:seo-mcp && npm run test:free-registry && npm run test:byok && npm run test:opencode-sync && npm run test:model-router && npm run test:provider-dashboard && npm run test:free-validation && npm run test:privacy && npm run test:security-build",
    "test": "npm run typecheck && npm run typecheck:website && npm run test:website && npm run audit:security && npm run deps:check",
    "preview": "electron dist/main/index.js",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:all": "npm run build && electron-builder -mwl --publish never",
    "release:notes": "node scripts/generate-release-notes.mjs",
    "dev:website": "vite --config website/vite.config.ts",
    "build:website": "vite build --config website/vite.config.ts",
    "build:pages": "npm run build:website",
    "pages:deploy": "wrangler pages deploy ./website-dist",
    "typecheck:website": "tsc --noEmit --project website/tsconfig.json",
    "test:website": "node scripts/validate-website.mjs"
  },
  "keywords": [
    "electron",
    "monaco-editor",
    "ai-assistant",
    "claude-code",
    "coding-agent",
    "openrouter",
    "ollama"
  ],
  "author": "Ty-Code Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.9",
    "highlight.js": "11.12.0",
    "lucide-react": "1.56.0",
    "monaco-editor": "0.52.2",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "simple-git": "4.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
