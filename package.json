{
  "name": "ty-claude",
  "version": "0.1.0",
  "description": "Standalone Electron Desktop AI Coding Assistant with Monaco Editor and Pluggable LLMs",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:node-pty --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "preview": "electron dist/main/index.js",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "monaco-editor",
    "ai-assistant",
    "claude-code",
    "antigravity",
    "coding-agent",
    "openrouter",
    "ollama"
  ],
  "author": "Ty-Claude Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
