{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "ty-code",
  "pages_build_output_dir": "./website-dist",
  "compatibility_date": "2026-10-15",
  "vars": {
    "GITHUB_REPO": "JTyrell/Ty-Code"
  },
  "analytics_engine_datasets": [
    {
      "binding": "SITE_ANALYTICS",
      "dataset": "ty-code"
    },
    {
      "binding": "ty-code-analytics-eng",
      "dataset": "ty-code"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS_BUCKET",
      "bucket_name": "ty-code-downloads"
    }
  ]
}
